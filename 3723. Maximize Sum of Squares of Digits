class Solution {
    public String maxSumOfSquares(int num, int sum) {
        if ((long) num * 9 < sum) {
            return "";
        }
        
        StringBuilder sb = new StringBuilder();
        
        for (int i = 0; i < num; i++) {
            int minDigit = Math.max(0, sum - (num - 1 - i) * 9);
            int maxDigit = Math.min(9, sum);
            
            int chosen = maxDigit;
            while (chosen >= minDigit) {
                int remainingSumAfterChoice = sum - chosen;
                int remainingSpots = num - 1 - i;
                if ((long) remainingSpots * 9 >= remainingSumAfterChoice) {
                    break;
                }
                chosen--;
            }
            
            sb.append(chosen);
            sum -= chosen;
        }
        
        return sum == 0 ? sb.toString() : "";
    }
}
