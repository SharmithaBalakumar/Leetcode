class Solution {
    public String[] createGrid(int m, int n) {
        String[] grid = new String[m];
        StringBuilder sb = new StringBuilder();
        
        // Constructing rows
        for (int i = 0; i < m; i++) {
            sb.setLength(0);
            for (int j = 0; j < n; j++) {
                // If we are in the first row OR the last column, we keep it as '.'
                // Except for (0,n-1) which connects them, but keeping first row and last column '.' works.
                if (i == 0 || j == n - 1) {
                    sb.append('.');
                } else {
                    sb.append('#');
                }
            }
            grid[i] = sb.toString();
        }
        return grid;
    }
}
