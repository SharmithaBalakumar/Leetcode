import java.util.Arrays;

class Solution {
    public long minSumSquareDiff(int[] nums1, int[] nums2,
                                 int k1, int k2) {

        int n = nums1.length;
        int[] diff = new int[n];

        long total = 0;

        for (int i = 0; i < n; i++) {
            diff[i] = Math.abs(nums1[i] - nums2[i]);
            total += diff[i];
        }

        long k = (long) k1 + k2;

        // All differences can become zero
        if (k >= total) {
            return 0;
        }

        Arrays.sort(diff);

        // Process largest differences first
        int max = diff[n - 1];
        int count = 1;

        for (int i = n - 2; i >= 0; i--) {
            long needed = (long) (max - diff[i]) * count;

            if (k >= needed) {
                k -= needed;
                max = diff[i];
                count++;
            } else {
                break;
            }
        }

        // Reduce the remaining largest differences evenly
        int reduce = (int) (k / count);
        int remainder = (int) (k % count);

        long answer = 0;

        for (int i = 0; i < n; i++) {
            int d = diff[i];

            if (d > max) {
                d = max;
            }

            if (d > max - reduce) {
                d = max - reduce;
            }

            answer += (long) d * d;
        }

        // The remainder can reduce some differences by one more
        answer -= (long) remainder *
                  (2L * (max - reduce) - 1);

        return answer;
    }
}
